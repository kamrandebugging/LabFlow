{
	on_demand_tls {
		ask http://backend:8000/internal/tls-check
		interval 2m
		burst 5
	}
}

*.{$PLATFORM_BASE_DOMAIN:localhost}, {$PLATFORM_BASE_DOMAIN:localhost} {
	tls {
		on_demand
	}

	# Security Rule: internal endpoints are strictly blocked from public ingress (Doc 01 §15, Doc 04 §6.4)
	handle /internal/* {
		respond 404
	}

	# Placeholder gateway response until backend & frontend are mounted
	handle {
		respond "LabFlow Edge Gateway Ready" 200
	}
}
