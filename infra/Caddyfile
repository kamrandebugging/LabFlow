{
	on_demand_tls {
		ask http://backend:8000/internal/tls-check
		interval 2m
		burst 5
	}
}

# Internal probe surface for the on-demand TLS `ask` endpoint. Never published:
# only reachable from inside the Compose network.
http://backend:8000 {
	respond /internal/tls-check 200
}

*.{$PLATFORM_BASE_DOMAIN:localhost}, {$PLATFORM_BASE_DOMAIN:localhost} {
	tls {
		on_demand
	}

	# Security Rule: internal endpoints are strictly blocked from public ingress (Doc 01 §15, Doc 04 §6.4)
	handle /internal/* {
		respond 404
	}

	# Control plane: Django (apex admin API, tenant APIs, django admin, assets)
	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /admin/* {
		reverse_proxy backend:8000
	}

	handle /static/* {
		reverse_proxy backend:8000
	}

	handle /media/* {
		reverse_proxy backend:8000
	}

	handle /healthz {
		reverse_proxy backend:8000
	}

	handle /readyz {
		reverse_proxy backend:8000
	}

	# Everything else is the single-page application. The SPA owns client-side
	# routing, so unknown paths fall back to index.html (Doc 07 §5).
	handle {
		root * /srv/spa
		try_files {path} /index.html
		file_server
	}
}
