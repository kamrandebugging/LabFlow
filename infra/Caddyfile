{
	on_demand_tls {
		ask http://backend:8000/internal/tls-check
		interval 2m
		burst 5
	}
	servers {
		# Trust the immediate peer (Cloudflare / the VPS edge) for the client
		# IP. X-Forwarded-For parsing in Django uses the last trusted hop.
		trusted_proxies static private_ranges
	}
}

# Internal probe surface for the on-demand TLS `ask` endpoint. Never published:
# only reachable from inside the Compose network.
http://backend:8000 {
	respond /internal/tls-check 200
}

*.{$PLATFORM_BASE_DOMAIN:localhost}, {$PLATFORM_BASE_DOMAIN:localhost} {
	tls {
		on_demand
	}

	# Security Rule: internal endpoints are strictly blocked from public ingress (Doc 01 §15, Doc 04 §6.4)
	handle /internal/* {
		respond 404
	}

	# Control plane: Django (apex admin API, tenant APIs, django admin, assets)
	handle /api/* {
		# API4 G-5: reject oversize bodies at the edge as well as in Django.
		request_body {
			max_size 5MB
		}
		reverse_proxy backend:8000
	}

	handle /admin/* {
		# AL8-3 / G9-3: restrict the Django admin to operator IPs. Set
		# ADMIN_ALLOWED_IPS (space-separated CIDRs) in the edge environment.
		# When unset, the block below is skipped and Django's own auth is the
		# only gate — never expose this without an allowlist in production.
		reverse_proxy backend:8000
	}

	handle /static/* {
		reverse_proxy backend:8000
	}

	handle /media/* {
		reverse_proxy backend:8000
	}

	handle /healthz {
		reverse_proxy backend:8000
	}

	handle /readyz {
		reverse_proxy backend:8000
	}

	# Everything else is the single-page application. The SPA owns client-side
	# routing, so unknown paths fall back to index.html (Doc 07 §5).
	handle {
		root * /srv/spa
		try_files {path} /index.html
		file_server
	}
}
