# ==============================================================================
# LabFlow Environment Variable Inventory (Doc 01 §15, Doc 08 §6)
# Safe development placeholders only. NEVER commit real secrets or production keys.
# Copy to .env for local development: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database (Doc 01 §15, Doc 02 §4, §5)
# ------------------------------------------------------------------------------
# Database name for PostgreSQL instance
POSTGRES_DB=labflow
# Superuser / application role username
POSTGRES_USER=labflow_app
# Password for PostgreSQL application role
POSTGRES_PASSWORD=labflow_dev_password
# Database host for container communication
POSTGRES_HOST=postgres
# Database port
POSTGRES_PORT=5432
# Combined connection URL used by Django backend (Doc 08 §6)
DATABASE_URL=postgresql://labflow_app:labflow_dev_password@postgres:5432/labflow

# ------------------------------------------------------------------------------
# 2. Redis (Broker, Cache, Throttling - Doc 01 §15, Doc 02 §14)
# ------------------------------------------------------------------------------
# Redis connection URL for Celery message broker and Django application cache
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 3. Object Storage: MinIO (Local) / Cloudflare R2 (Prod) (Doc 01 §6, Doc 08 §6)
# ------------------------------------------------------------------------------
# Access key ID for S3-compatible API (MinIO root user locally)
R2_ACCESS_KEY_ID=minioadmin
# Secret access key for S3-compatible API (MinIO root password locally)
R2_SECRET_ACCESS_KEY=minioadmin123
# Primary bucket name for reports, statements, and exports
R2_BUCKET_NAME=labflow
# S3 API endpoint URL (http://minio:9000 for local development)
R2_ENDPOINT_URL=http://minio:9000

# ------------------------------------------------------------------------------
# 4. n8n Automation & Webhooks (Doc 01 §13, Doc 06 §5, Doc 08 §6)
# ------------------------------------------------------------------------------
# Shared secret for HMAC-SHA256 signature verification on Django -> n8n webhooks
N8N_WEBHOOK_SECRET=dev_n8n_webhook_secret_32_characters_minimum
# Shared bearer token for authenticating n8n -> Django callbacks
N8N_CALLBACK_KEY=dev_n8n_callback_key_secret_value
# Secondary callback key for zero-downtime rotation (Doc 06 §5.5, Doc 08 §6)
N8N_CALLBACK_KEY_NEXT=

# ------------------------------------------------------------------------------
# 5. Caddy Edge Proxy & Domain Routing (Doc 01 §15, Doc 04 §6, Doc 08 §6)
# ------------------------------------------------------------------------------
# Apex base domain for tenant subdomain routing and ask endpoint
PLATFORM_BASE_DOMAIN=localhost

# ------------------------------------------------------------------------------
# 6. Backend: Django, Security & Cryptography (Doc 01 §15, Doc 08 §4, §6, §12)
# ------------------------------------------------------------------------------
# Django core secret key for cryptographic signing (Doc 08 §6)
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production-minimum-50-chars-long
# Secret key used strictly for HS256 JWT access and refresh token signing (Doc 08 §4.3)
JWT_SIGNING_KEY=jwt-secret-key-for-local-dev-signing-minimum-32-chars-length
# 32-byte Fernet key for encrypting staff TOTP secrets at rest (Doc 08 §4.4)
LABFLOW_TOTP_ENCRYPTION_KEY=dGVzdF9mZXJuZXRfa2V5XzMyX2J5dGVzX2xvY2FsX2Rldl8=
# Write-only Sentry DSN for backend and SPA error tracking (empty disables Sentry locally)
SENTRY_DSN=
# Public age recipient key for encrypting database backups (Doc 08 §12.2)
AGE_RECIPIENT_BACKUP=age1devplaceholderbackuprecipientkey000000000000000000000000000
# Public age recipient key for encrypting audit log archives (Doc 08 §9.4, §12.2)
AGE_RECIPIENT_AUDIT_ARCHIVE=age1devplaceholderauditarchiverecipientkey00000000000000000000
# Default validity in days for patient report access tokens (Doc 01 §15, Doc 03 RP-8)
REPORT_LINK_TTL_DAYS=7
# Validity in seconds for pre-signed S3 storage redirect URLs (Doc 01 §15, Doc 03 RP-8)
REPORT_SIGNED_URL_TTL_SECONDS=900
