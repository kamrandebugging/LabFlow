# ==============================================================================
# LabFlow — Environment Configuration Template (.env.example)
# Do NOT commit actual secrets to version control.
# ==============================================================================

# Core Django Configuration
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=.labflow.app,localhost,127.0.0.1
PLATFORM_BASE_DOMAIN=labflow.app

# Database & Cache (PostgreSQL 16 + Redis 7)
DATABASE_URL=postgres://labflow_app:replace_password@postgres:5432/labflow_db
REDIS_URL=redis://:replace_redis_password@redis:6379/0

# Authentication & Encryption (Doc 08 §6)
JWT_SIGNING_KEY=replace-with-jwt-signing-secret
LABFLOW_TOTP_ENCRYPTION_KEY=replace-with-fernet-key-32-urlsafe-base64-bytes

# Automation & n8n Integration (Doc 06 §13, Doc 08 §6)
N8N_WEBHOOK_SECRET=replace-with-n8n-webhook-signing-secret
N8N_CALLBACK_KEY=replace-with-n8n-callback-key
N8N_CALLBACK_KEY_NEXT=

# Cloudflare R2 / S3 Object Storage (Doc 01 §15, Doc 08 §6)
R2_ACCESS_KEY_ID=replace_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_r2_secret_access_key
R2_BUCKET_NAME=labflow-storage
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# Backup Encryption (age public recipients, Doc 08 §6, §12)
AGE_RECIPIENT_BACKUP=age1replace_with_public_recipient_key_for_backups
AGE_RECIPIENT_AUDIT_ARCHIVE=age1replace_with_public_recipient_key_for_audit

# Observability
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Time-To-Live Settings (Defaults)
REPORT_LINK_TTL_DAYS=7
REPORT_SIGNED_URL_TTL_SECONDS=900

