# ============================================================
# LabFlow — local environment template
# Copy to .env and replace every value marked <REPLACE>. NEVER commit .env.
# See Doc 08 §6 for the full env var inventory.
# ============================================================

# ---- Postgres (Subtask 2) ----
# The three POSTGRES_* values below compose DATABASE_URL further down.
# Change all four together or the backend cannot connect.
POSTGRES_DB=labflow
POSTGRES_USER=labflow
POSTGRES_PASSWORD=<REPLACE>

# Consumed by the backend service (added in a later subtask).
# Must use the same user, password, db name, and host as the POSTGRES_* vars above.
# Host is `postgres` because the backend reaches the container by its service name on the internal network.
DATABASE_URL=postgresql://labflow:<REPLACE>@postgres:5432/labflow
